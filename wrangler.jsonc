
{
  "name": "file-viewer",
  "main": "src/index.js",
  "compatibility_date": "2026-11-13",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "durable_objects": {
    "bindings": [
      {
        "name": "PAIRING_ROOM",
        "class_name": "PairingRoom"
      }
    ]
  },

  "exports": {
    "PairingRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
